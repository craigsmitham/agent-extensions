#!/bin/sh
set -eu

required_axm_version="0.26.2"

if ! command -v axm >/dev/null 2>&1; then
  echo "AXM ${required_axm_version} is required for the public safety pre-commit hook." >&2
  echo "Install it from https://axm.sh, then retry the commit." >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
exec "$repo_root/scripts/check-public-safety.sh" --view git-index
